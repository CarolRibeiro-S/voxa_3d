# Supabase (painel do projeto > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-aqui
# Somente servidor. Nunca usar prefixo NEXT_PUBLIC e nunca importar em codigo de cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Endereço público do site (usado nos links de convite). Sem esta variável, usa o endereço da requisição.
NEXT_PUBLIC_SITE_URL=https://voxa3d.com.br

# Envio de e-mail (Resend), só no servidor. Sem as duas variáveis, o convite só gera o link para copiar.
RESEND_API_KEY=sua-chave-do-resend-aqui
# Remetente verificado no Resend, por exemplo: Voxa3D <convites@voxa3d.com.br>
RESEND_FROM_EMAIL=Voxa3D <convites@seu-dominio.com.br>
